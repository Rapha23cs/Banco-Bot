# ==============================================================================
# SGA 360° • Robô de Sincronização de Banco de Dados (.env.example)
# Copie este arquivo para .env e ajuste com as credenciais reais do ambiente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Conexões de Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
# Banco Local (exemplo: porta padrão 5432)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/meu_banco
LOCAL_DATABASE_URL=postgresql://postgres:senha@localhost:5432/meu_banco

# Banco de Produção (Coolify / Nuvem / IP interno)
# Exemplo: postgresql://usuario:senha@192.168.0.10:5432/meu_banco
PROD_DATABASE_URL=postgresql://usuario:senha_producao@192.168.0.10:5432/meu_banco

# ------------------------------------------------------------------------------
# 2. Configurações de Automação / Robô (Modo Não-Interativo)
# ------------------------------------------------------------------------------
# Sentido padrão quando executado sem argumentos CLI: 'push' ou 'pull'
SYNC_DIRECTION=push

# Confirmação automática para rotinas agendadas (true = sem trava de prompt)
SYNC_AUTO_CONFIRM=false

# Modo de exclusão no PUSH: true = espelho completo | false = incremental
SYNC_DELETE_MISSING=true

# Tabelas a ignorar (separadas por vírgula)
# SYNC_EXCLUDE_TABLES=usuarios,auditoria

# ------------------------------------------------------------------------------
# 3. Atualização Automática do Executável (NSIS ou Portátil)
# ------------------------------------------------------------------------------
# Aceita: URL do GitHub Releases (https://github.com/org/repo),
# URL HTTP de manifesto/pasta (https://servidor/ecosync/latest.json)
# ou pasta de rede/local Windows (\\servidor\ecosync ou C:\Updates\EcoSync)
# APP_UPDATE_URL=
# Token GitHub opcional (somente para repositório privado com leitura de Releases)
# APP_UPDATE_TOKEN=

